---
const { defaultValue, inputId, cardLabel } = Astro.props;
---

<div class:list={[`ingredient-card-${inputId}`, "cardLayout"]}>
    <h3 class="section-title">{cardLabel}</h3>
    {
        inputId === "target" ? null : (
            <input
                class="ingredient-name-input"
                id={inputId}
                type="text"
                value={defaultValue?.label}
                maxlength="24"
            />
        )
    }

    <div class="field-group">
        {
            inputId === "target" ? (
                <label
                    class="pearsonInput_label"
                    for={defaultValue?.inputValueId}
                >
                    Crude Protein:
                </label>
            ) : (
                <label
                    class="pearsonInput_label"
                    for={defaultValue?.inputValueId}
                >
                    Crude Protein:
                </label>
            )
        }
        <div class="input-row">
            <input
                type="number"
                id={defaultValue?.inputValueId}
                min="0"
                max="100"
                step="0.1"
                value={defaultValue?.inputValue}
                placeholder={`e.g. ${defaultValue?.inputValue}`}
            />
            <span class="input-suffix">%</span>
        </div>
    </div>
</div>

<style>
    .cardLayout {
        width: 50;
        display: grid;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .ingredient-card-itemA {
        padding-left: 7px;
        border-left: 4px solid var(--primary-color);
    }
    .ingredient-card-itemB {
        padding-left: 7px;
        border-left: 4px solid var(--accent-bright-color);
    }
    .ingredient-card-target {
        padding-left: 7px;
        border-left: 4px solid var(--accent-dull-color);
    }

    .field-group {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        grid-row: var(--fieldGroup_gridRow, 3);

        justify-content: flex-start;
        gap: 15px;
    }

    .ingredient-card {
        background: white;
        border: 1px solid rgba(160, 98, 42, 0.15);
        padding: 1.2rem;
        position: relative;
    }

    .ingredient-name-input {
        grid-row: 2;
        grid-column: 1 / span 2;
        width: 100%;
        border: none;
        border-bottom: 1.5px solid var(--primary-color);
        background: transparent;
        font-family: "Playfair Display", serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        padding: 0.2rem 0;
        margin-bottom: 0.8rem;
        outline: none;
        transition: border-color 0.2s;
        border-radius: 0px;
    }
</style>
